# Copy to android/keystore.properties (GITIGNORED) or set the environment
# variables instead. The build reads the properties file first, then the env.
#
# The keystore file itself must live OUTSIDE this repository and must be backed
# up before the first install: the AndroidKeyStore key that seals the server
# list is bound to the signing identity, so replacing the keystore destroys
# every stored pin, and a release-signed APK cannot upgrade a debug-signed one.
#
# Generate it once (never from this build, and never checked in):
#
#   & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v `
#       -keystore C:\Users\temp\.android-keys\homelab-rmm-release.jks `
#       -storetype PKCS12 -keyalg RSA -keysize 4096 -validity 10000 `
#       -alias rmm -dname "CN=Homelab RMM, O=Homelab"
#
# Keep it out of any Bitdefender-locked path.

storeFile=C:/Users/temp/.android-keys/homelab-rmm-release.jks
storePassword=
keyAlias=rmm
keyPassword=

# Environment equivalents:
#   RMM_KEYSTORE   -> storeFile
#   RMM_KS_PASS    -> storePassword
#   RMM_KEY_ALIAS  -> keyAlias
#   RMM_KEY_PASS   -> keyPassword
